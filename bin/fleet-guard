#!/bin/sh
# fleet-guard — Claude Code PreToolUse hook. Two protections:
#  (1) ALWAYS-ON: a worker agent (FLEET_ROLE=worker) may not `git merge` or
#      `git push`. Integration is the ORCHESTRATOR's job — it reviews returned
#      diffs and merges/pushes. A worker that self-merges into main bypasses
#      review (and worktree isolation only stops it from *checking out* main, not
#      from `git push . HEAD:main` or merging via another worktree). This block is
#      independent of the opt-in marker below.
#  (1b) ALWAYS-ON (unless `fleet autocommit on`): a worker may not `git commit`.
#      Workers STAGE (`git add -A`) and stop; the human reviews and makes the one
#      commit. `git add` is deliberately NOT blocked — staging is what makes the
#      work visible and the human's commit a one-liner.
#  (2) OPT-IN (`fleet guard on`): ask/deny before edits to protected paths
#      (tests, CI configs, lockfiles) so agents can't quietly delete tests or
#      rewrite CI to make things pass.
# Fail-silent and fast — on any doubt, allow.
set -eu

CFG="${XDG_CONFIG_HOME:-$HOME/.config}/fleet"
command -v python3 >/dev/null 2>&1 || exit 0

in="$(cat 2>/dev/null || true)"
[ -n "$in" ] || exit 0

# The guard-on marker gates protection (2) only; protection (1) is always active.
GUARD_ON=0; [ -f "$CFG/guard-on" ] && GUARD_ON=1

FLEET_GUARD_INPUT="$in" FLEET_GUARD_CFG="$CFG" FLEET_GUARD_ON="$GUARD_ON" python3 - <<'PY' || exit 0
import json, os, fnmatch, sys, re, shlex

try:
    h = json.loads(os.environ["FLEET_GUARD_INPUT"])
except Exception:
    sys.exit(0)

tool = str(h.get("tool_name") or "")
role = os.environ.get("FLEET_ROLE", "")

def deny(reason):
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": reason,
    }}))
    sys.exit(0)

# --- (1) ALWAYS-ON: workers must not merge or push -------------------------------
# Find `git merge`/`git push` only when `git` is the COMMAND WORD of a statement,
# not when the words "git merge" merely appear inside some other command's quoted
# argument (e.g. `fleet send x "... do the git merge now"`). The old scan split on
# separators with a naive `seg.split()` and matched `git` ANYWHERE in the token
# list, so any quoted body containing "git merge"/"git push" was falsely denied.
#
# The fix tokenizes QUOTE-AWARE *once* over the WHOLE text (shlex), so a quoted
# "git push" stays a single token and never matches; it then segments on the shell
# operator tokens (; & | && ||) and takes the first non-`VAR=value` token of each
# run as the command word. A separator INSIDE a quote can no longer desync the
# parse (the bug a split-before-parse scheme reintroduces).
#
# A NEWLINE is a separator only when it is OUTSIDE quotes. Splitting on `\n` before
# parsing threw that away: a multi-line quoted payload (the normal shape of
# `fleet new -p "…"`) was cut into fragments, each with unbalanced quotes, and an
# indented payload line read as a command word -> false DENY. So statement
# separation comes from the same quote-aware walk that lifts substitutions: an
# unquoted newline is emitted as "\n;" (the newline still terminates a `#` comment,
# the `;` is the real separator token), while a newline inside quotes stays data
# inside its token.
#
# fail-CLOSED for THIS block (the inverse of the guard's general "on any doubt,
# allow"): the always-on merge/push floor is an integrity control, so on an
# unbalanced-quote parse error we fall back to the conservative whitespace scan —
# which over-denies but never lets a real `git merge`/`git push` (e.g. a trailing
# `"`) slip past. A false deny on malformed input is recoverable (rephrase); a
# false allow merges unreviewed code into main. Opt-out: a worker spawned with
# `fleet new --self-merge` carries FLEET_SELF_MERGE=1 and is exempt.
#
# A quoted argument is INERT TEXT; the same characters in command-word position are
# an EXECUTED command. That distinction is the whole design here, and it cuts both
# ways — narrowing the false positives is only safe if every construct that turns
# text back INTO a command is followed:
#
#   * `$(…)` and backticks   — command substitution: the body is executed. shlex's
#                              punctuation_chars already splits `$(`; backticks are
#                              not punctuation, so they are rewritten to `;` FIRST
#                              (a `;` cannot break quote structure, so a backtick
#                              inside a single-quoted payload stays one inert token).
#   * `eval …`               — its arguments are re-parsed as a command: recurse on
#                              them joined by spaces, exactly as the shell does.
#   * `sh|bash|zsh|… -c "…"`  — the -c operand is a script: recurse into it.
#   * `xargs [opts] cmd …`   — the remainder is a command run: re-analyze it.
#   * env/nohup/time/timeout/sudo/… — transparent prefixes: strip and re-analyze.
#   * shell keywords (`then`, `do`, `{`, `!`, …) — `if true; then git push; fi` has
#                              `then` in front of the command word, not a command.
#   * `V="git push"; $V`     — simple assignments are tracked so an expanded command
#                              word resolves back to the command it names.
#
# fail-CLOSED for THIS block (the inverse of the guard's general "on any doubt,
# allow"): the always-on merge/push floor is an integrity control. On an
# unbalanced-quote parse error we cannot tell payload from command at all, so we
# fall back to a raw regex over the text — which over-denies (a payload mentioning
# the verb plus a stray quote is refused) but never lets a real `git merge`/`git
# push` slip past. A false deny on malformed input is recoverable (rephrase); a
# false allow merges unreviewed code into main. Opt-out: a worker spawned with
# `fleet new --self-merge` carries FLEET_SELF_MERGE=1 and is exempt.
#
# Remaining accepted gaps (this block is a speed-bump against ACCIDENTAL
# self-merge, not a sandbox): shell functions and aliases, a wrapper script whose
# name is not `git`, `find -exec`, and a command word built by expansion we cannot
# resolve (`$UNKNOWN`, `${x:-git}`, `g$(echo it)`).
ENV_ASSIGN = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$", re.S)
RAW_GIT = re.compile(r"\bgit\b(?:\s+-[^\s]*(?:\s+[^\s-][^\s]*)?)*\s+(merge|push)\b")
VAR_REF = re.compile(r"^\$\{?([A-Za-z_][A-Za-z0-9_]*)\}?$")

SHELLS = ("sh", "bash", "zsh", "dash", "ksh", "ash", "mksh", "busybox")
# transparent prefixes -> how many NON-option operands to drop before the command
PREFIX = {"env": 0, "nohup": 0, "command": 0, "builtin": 0, "exec": 0, "stdbuf": 0,
          "setsid": 0, "sudo": 0, "doas": 0, "time": 0, "nice": 0, "ionice": 0,
          "timeout": 1, "xargs": 0}
KEYWORD = ("if", "then", "else", "elif", "fi", "do", "done", "while", "until",
           "for", "case", "esac", "in", "{", "}", "!", "(", ")")
MAXDEPTH = 6


def is_op(tok):  # an operator token is made solely of shell metacharacters
    return tok != "" and all(c in "();<>|&" for c in tok)


def tokenize(text):
    """Quote-aware tokens, or None when the input does not parse."""
    try:
        lex = shlex.shlex(text, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        return list(lex)
    except ValueError:
        return None


def _close_subst(text, i):
    """Body and end index of the `…` / $(…) substitution starting at i, or None.

    Quote state matters and is NOT symmetric: inside DOUBLE quotes a substitution
    still runs (`echo "x $(git push)"` pushes), inside SINGLE quotes it is inert.
    So the caller skips single-quoted spans and calls us for everything else.
    """
    if text[i] == "`":
        j = i + 1
        while j < len(text):
            if text[j] == "\\":
                j += 2
                continue
            if text[j] == "`":
                return text[i + 1:j], j + 1
            j += 1
        return None
    j, depth, sq, dq = i + 2, 1, False, False
    while j < len(text):
        c = text[j]
        if sq:
            sq = c != "'"
        elif c == "\\":
            j += 1
        elif c == "'" and not dq:
            sq = True
        elif c == '"':
            dq = not dq
        elif not dq:
            if c == "(":
                depth += 1
            elif c == ")":
                depth -= 1
                if depth == 0:
                    return text[i + 2:j], j + 1
        j += 1
    return None


def lift_substitutions(text):
    """(text with substitutions blanked out, [their bodies]) or None if unbalanced.

    Lifting the bodies OUT — rather than rewriting them into `;`-separated
    statements in place — is what keeps quoting intact: the surrounding string
    stays exactly as balanced as it was, so a payload is still one inert token
    while the substituted body is scanned as the command it is.

    The same walk marks statement boundaries: a newline OUTSIDE quotes becomes
    "\\n;" (newline kept so a `#` comment still ends there, `;` as the separator
    token shlex will emit); a newline inside quotes is left alone, so a multi-line
    quoted payload stays one inert token.
    """
    out, bodies, i, sq, dq = [], [], 0, False, False
    while i < len(text):
        c = text[i]
        if sq:
            sq = c != "'"
            out.append(c)
        elif c == "\\" and i + 1 < len(text):
            out.append(c)
            out.append(text[i + 1])
            i += 2
            continue
        elif c == "'" and not dq:
            sq = True
            out.append(c)
        elif c == '"':
            dq = not dq
            out.append(c)
        elif c == "`" or (c == "$" and text[i + 1:i + 2] == "("):
            got = _close_subst(text, i)
            if got is None:
                return None                 # unbalanced -> caller falls CLOSED
            body, i = got
            bodies.append(body)
            out.append("_fleetsub_")
            continue
        elif c == "\n" and not dq:      # unquoted newline = statement separator
            out.append("\n;")
        else:
            out.append(c)
        i += 1
    return "".join(out), bodies


def scan_run(run, env, depth, out):
    """Record git subcommands executed by one statement (a run of words)."""
    if depth > MAXDEPTH:
        return
    k = 0
    while k < len(run):
        m = ENV_ASSIGN.match(run[k])
        if m:                                   # FOO=bar prefix (and remember it)
            env[m.group(1)] = m.group(2)
            k += 1
        elif run[k] in KEYWORD:                 # `then git push` is a command
            k += 1
        else:
            break
    if k >= len(run):
        return
    word = run[k]
    rest = run[k + 1:]

    v = VAR_REF.match(word)                     # V="git push"; $V
    if v:
        val = env.get(v.group(1))
        if val is not None:
            scan_text(val, env, depth + 1, out)
        return

    name = os.path.basename(word)

    if name == "git":
        j = 0
        while j < len(rest) and rest[j].startswith("-"):   # skip git global opts
            j += 2 if rest[j] in ("-C", "-c") and j + 1 < len(rest) else 1
        out.append(rest[j] if j < len(rest) else "")
        return

    if name == "eval":                          # args are re-parsed as a command
        scan_text(" ".join(rest), env, depth + 1, out)
        return

    if name in SHELLS:                          # sh -c '…'
        j = 0
        while j < len(rest):
            if rest[j] == "-c" and j + 1 < len(rest):
                scan_text(rest[j + 1], env, depth + 1, out)
                return
            if rest[j].startswith("-") and "c" in rest[j][1:] and j + 1 < len(rest):
                scan_text(rest[j + 1], env, depth + 1, out)
                return
            j += 1
        return

    if name in PREFIX:                          # env/xargs/timeout/… <command> …
        drop = PREFIX[name]
        j = 0
        while j < len(rest):
            if rest[j].startswith("-"):
                j += 1
            elif ENV_ASSIGN.match(rest[j]) and name in ("env", "sudo"):
                j += 1
            elif drop > 0:
                drop -= 1
                j += 1
            else:
                break
        scan_run(rest[j:], env, depth + 1, out)
        return


def scan_text(text, env, depth, out):
    """Record every git subcommand this shell text would EXECUTE."""
    if depth > MAXDEPTH:
        return
    lifted = lift_substitutions(text)
    if lifted is None:                          # fall CLOSED: unparseable input
        m = RAW_GIT.search(text)
        if m:
            out.append(m.group(1))
        return
    text, bodies = lifted
    for body in bodies:                         # `…` / $(…) bodies ARE executed
        scan_text(body, env, depth + 1, out)
    toks = tokenize(text)                       # ONE parse over the whole text
    if toks is None:                            # fall CLOSED: unparseable input
        m = RAW_GIT.search(text)
        if m:
            out.append(m.group(1))
        return
    run = []
    for tok in toks + [";"]:                    # sentinel flushes the final run
        if is_op(tok):
            if run:
                scan_run(run, env, depth, out)
            run = []
        else:
            run.append(tok)


if tool == "Bash" and role == "worker":
    cmd = str((h.get("tool_input") or {}).get("command") or "")
    subs = []
    scan_text(cmd, {}, 0, subs)

    if os.environ.get("FLEET_SELF_MERGE") != "1":
        for sub in subs:
            if sub in ("merge", "push"):
                deny("fleet-guard: workers must not run 'git %s'. Integration is the "
                     "orchestrator's job — it reviews your diff and merges/pushes. "
                     "Stage your work with 'git add -A' and run 'fleet ready'; a human "
                     "reviews and commits." % sub)

    # --- (1b) ALWAYS-ON (unless `fleet autocommit on`): workers must not COMMIT ---
    # Workers STAGE and stop; the human makes the one commit that enters history.
    # This is a BACKSTOP, not a wall — the real lever is the wording seeded into
    # every worker (`ready_instructions`), which is also the only lever that reaches
    # non-claude harnesses (omp has no guard at all). The documented tokenizer gaps
    # above (`sh -c`, `eval`, aliases, wrapper scripts) apply here identically.
    #
    # `add` is DELIBERATELY ABSENT from this set and must stay absent: staging is
    # load-bearing for the whole feature (`git diff HEAD` includes the index, so
    # staged work is what makes the human's review surface honest and the human's
    # commit a single command). `stash` and `rebase` are absent too — a worker needs
    # `rebase --abort` and a non-destructive park.
    if os.environ.get("FLEET_AUTOCOMMIT") != "1":
        for sub in subs:
            if sub in ("commit", "commit-tree", "am", "cherry-pick", "revert"):
                deny("fleet-guard: workers must not run 'git %s' — nothing on this "
                     "branch gets committed by an agent. Stage everything with "
                     "'git add -A' (do NOT commit), then run 'fleet ready'; a human "
                     "reviews the staged tree and makes the commit. If this pane "
                     "genuinely needs to commit, the human can allow it with "
                     "'fleet autocommit on'." % sub)

# --- (2) OPT-IN: protected-path edits (tests / CI / lockfiles) -------------------
if os.environ.get("FLEET_GUARD_ON") != "1":
    sys.exit(0)
if tool not in ("Edit", "Write", "MultiEdit", "NotebookEdit"):
    sys.exit(0)
path = str((h.get("tool_input") or {}).get("file_path") or "")
if not path:
    sys.exit(0)
base = os.path.basename(path)

# Built-in defaults: test files, CI configs, lockfiles. A leading '!' on a
# pattern means hard-deny instead of ask.
patterns = [
    "*_test.go", "*_test.py", "test_*.py", "*.test.*", "*.spec.*",
    "*Tests.cs", "*Test.cs", "*Tests.java", "*Test.java",
    "*/tests/*", "*/test/*", "*/__tests__/*", "*/spec/*",
    ".github/workflows/*", "*/.github/workflows/*", "*.yml.ci", "azure-pipelines*.yml",
    "*.lock", "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "Cargo.lock",
    "Gemfile.lock", "poetry.lock", "composer.lock", "go.sum",
]

# Per-repo + global overrides: <cwd ancestor>/.fleet/protected and $CFG/protected.
def load(p):
    try:
        with open(p, encoding="utf-8") as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#")]
    except Exception:
        return []

cwd = str(h.get("cwd") or "")
extra = []
d = cwd
for _ in range(40):
    extra += load(os.path.join(d, ".fleet", "protected"))
    nd = os.path.dirname(d)
    if nd == d:
        break
    d = nd
extra += load(os.path.join(os.environ["FLEET_GUARD_CFG"], "protected"))
patterns += extra

def matches(pat, path, base):
    pat = pat.strip()
    return fnmatch.fnmatch(path, pat) or fnmatch.fnmatch(base, pat) \
        or fnmatch.fnmatch(path, "*/" + pat)

deny_flag = False
hit = None
# Evaluate ALL patterns, not just the first match: a user's bang-prefixed hard
# deny must win over a built-in soft-ask regardless of list order. A hard deny is
# terminal (stop early); a soft match is only provisional — keep scanning in case
# a later pattern denies.
for pat in patterns:
    hard = pat.startswith("!")
    p = pat[1:] if hard else pat
    if matches(p, path, base):
        if hard:
            deny_flag = True
            hit = p
            break
        if hit is None:
            hit = p

if hit is None:
    sys.exit(0)

decision = "deny" if deny_flag else "ask"
reason = ("fleet-guard: %s is protected (%s). %s"
          % (base, hit,
             "Edit blocked — remove it from .fleet/protected to allow."
             if deny_flag else "Confirm this change is intended."))
print(json.dumps({"hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": decision,
    "permissionDecisionReason": reason,
}}))
PY
exit 0
